# =============================================================
#  ConecTEA — Exemplo de variáveis de ambiente
# =============================================================
#
#  COMO USAR
#    cp .env.example .env.local
#    e preencha os valores recebidos por canal seguro.
#
#  REGRAS
#    1. Este arquivo é versionado e contém APENAS nomes. Nunca valores.
#    2. O .env.local NUNCA é commitado (está no .gitignore).
#    3. Variáveis com prefixo NEXT_PUBLIC_ são publicadas no navegador.
#       JAMAIS use esse prefixo em segredo. Ver: 11 - Segurança/Gestão de Secrets
#    4. Toda variável nova aqui precisa ser cadastrada também na Vercel.
#
# =============================================================


# -------------------------------------------------------------
#  APLICAÇÃO
# -------------------------------------------------------------

# URL base da aplicação
#   dev:     http://localhost:3000
#   preview: URL gerada pela Vercel
NEXT_PUBLIC_SITE_URL=


# -------------------------------------------------------------
#  SUPABASE
#  Painel → Project Settings → API
# -------------------------------------------------------------

# 🟢 PÚBLICA — URL do projeto
NEXT_PUBLIC_SUPABASE_URL=

# 🟢 PÚBLICA — chave anônima.
#    Pode ir para o navegador porque quem protege os dados é a RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 🔴 SECRETA — ignora toda a RLS. É a chave mestra do banco.
#    Somente no servidor. Nunca no cliente. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 🔴 SECRETA — conexão direta com o Postgres (migrations, seeds)
DATABASE_URL=


# -------------------------------------------------------------
#  STRIPE  —  ainda não implementado, ver 18 - Pagamentos
#  Painel → Developers → API keys
# -------------------------------------------------------------

# 🟢 PÚBLICA — pk_test_... em desenvolvimento
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# 🔴 SECRETA — sk_test_... em desenvolvimento, sk_live_... em produção
STRIPE_SECRET_KEY=

# 🔴 SECRETA — whsec_..., obtida ao criar o endpoint de webhook
#    Sem ela, qualquer pessoa pode falsificar um pagamento aprovado.
STRIPE_WEBHOOK_SECRET=


# -------------------------------------------------------------
#  EM DEFINIÇÃO
#  Descomente conforme as integrações forem aprovadas.
# -------------------------------------------------------------

# Envio de e-mail
# RESEND_API_KEY=

# Monitoramento de erros
# SENTRY_DSN=
